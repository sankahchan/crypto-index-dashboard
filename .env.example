# Standalone deployment only. The current Muse-hosted artifact does not read this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_BASE_URL=https://your-domain.example
APP_TIMEZONE=Asia/Yangon
CRON_SECRET=replace-with-a-long-random-value

# Required only for AI-authored bilingual briefs, summaries, and sentiment
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
