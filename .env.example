# Standalone deployment only (VPS / Docker). The Muse-hosted artifact does not read this file.
# The installer copies this to .env on first run; re-running the installer never overwrites .env.

# ---- Server ----
PORT=3000
# SQLite database directory (mounted as a Docker volume; survives redeploys)
DATA_DIR=/app/data
# IANA timezone for the daily 08:22 market update and Monday 08:22 weekly digest
APP_TIMEZONE=Asia/Seoul

# Optional: trigger refresh jobs remotely, e.g.
#   curl -X POST -H "x-cron-secret: <secret>" http://your-vps:3000/api/refresh/market
# Jobs: market | daily | weekly. Leave empty to disable the endpoint.
CRON_SECRET=change-me-to-a-long-random-string

# ---- AI (optional, recommended) ----
# Powers AI market briefs, news-sentiment summaries, and trading-signal AI
# assessments. Without any key the dashboard still works; AI-powered sections
# show honest "not configured" states instead of failing.
# Comma-separated priority list (first key found wins per call):
AI_PROVIDERS=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
# DEEPSEEK_MODEL=deepseek-chat

# ---- Web search (optional) ----
# Powers the news pipeline (news sentiment, market intelligence).
# Without a key, news sections stay empty but nothing crashes.
# Providers: tavily | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
