# Standalone deployment only. The current Muse-hosted artifact does not read this file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_BASE_URL=https://your-domain.example
APP_TIMEZONE=Asia/Yangon
CRON_SECRET=replace-with-a-long-random-value

# AI providers for bilingual briefs, summaries, and sentiment.
# Comma-separated priority order: the first working provider wins,
# the rest are automatic fallbacks. Only providers with a key set are tried.
# (The older single AI_PROVIDER variable is still honored as a one-entry list.)
AI_PROVIDERS=gemini,openai,anthropic,deepseek
AI_TIMEOUT_MS=60000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
